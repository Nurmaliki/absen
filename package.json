		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^26.6.3",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/ui": "^5.0.2",
		"fake-indexeddb": "^6.2.4",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
